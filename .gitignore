node_modules
dist
.env
.env.e2e

# Playwright
e2e/.auth/
playwright-report/
test-results/
blob-report/

# Supabase CLI — needed only to deploy the Storage cleanup Edge Function.
# See supabase/functions/cleanup-orphaned-photos/README.md.
#
# CLEANUP_SECRET authorises a call to that function, and is fed to
# `supabase secrets set --env-file .env.cleanup`. Like .env and .env.e2e
# above, it never belongs in the repository.
.env.cleanup
# Written by `supabase link`: holds the linked project ref and a CLI
# session. supabase/config.toml, beside it, IS committed — that's the
# project's own configuration rather than a local credential.
supabase/.temp/

# Schema reports from scripts/schema-report.sql. Working files for
# `npm run schema:diff` - a point-in-time dump of a live database's
# structure, not something to version. schema.sql is the tracked copy.
production.json
e2e.json
*.schema-report.json
