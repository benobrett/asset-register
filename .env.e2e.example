# Copy to .env.e2e and fill in - a SEPARATE Supabase project from the one
# .env points at, so e2e test data (assets/repairs/comments it creates)
# never lands in the real, shared register. See CLAUDE.md's testing
# conventions for why.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# A dedicated test account in that same e2e project - created via the
# Supabase dashboard (Authentication -> Users -> Create new user, with
# Auto Confirm) rather than signup, and given a name directly in the
# profiles table, since the dashboard path leaves it null.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
