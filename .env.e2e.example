# Copy to .env.e2e and fill in - a SEPARATE Supabase project from the one
# .env points at, so e2e test data (assets/repairs/comments it creates)
# never lands in the real, shared register. See CLAUDE.md's testing
# conventions for why.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# A dedicated test account in that same e2e project - created via the
# Supabase dashboard (Authentication -> Users -> Create new user, with
# Auto Confirm) rather than signup, and given a name directly in the
# profiles table, since the dashboard path leaves it null.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# A second dedicated account in that same e2e project - same "Create new
# user" path as above, but deliberately left with no name on file (skip
# the profiles update). Used to test the #/complete-profile routing gate.
# Never complete this account's profile in any spec - profiles' RLS
# forbids ever resetting a name once it's set, so doing so would break
# this account's usefulness for good.
E2E_INCOMPLETE_PROFILE_EMAIL=
E2E_INCOMPLETE_PROFILE_PASSWORD=
